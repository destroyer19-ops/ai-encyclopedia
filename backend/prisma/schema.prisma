generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id               String       @id @default(uuid())
  email            String       @unique
  passwordHash     String?      @map("password_hash")
  authProvider     String       @map("auth_provider")
  role             String       @default("learner")
  gender           String?
  birthYear        Int?         @map("birth_year")
  nationality      String?
  employmentStatus String?      @map("employment_status")
  persona          String?
  enrollments      Enrollment[]
  submissions      AssignmentSubmission[]
  certificates     Certificate[]
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  @@map("users")
}

model UserRole {
  id      String @id @default(uuid())
  userId  String @map("user_id")
  role    String

  @@map("user_roles")
}

model Profile {
  id        String   @id @default(uuid())
  email     String
  firstName String?  @map("first_name")
  lastName  String?  @map("last_name")
  avatarUrl String?  @map("avatar_url")
  country   String?
  phone     String?
  theme     String   @default("system")
  locale    String   @default("en")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("profiles")
}

model EducatorProfile {
  id            String   @id @default(uuid())
  userId        String   @map("user_id") @unique
  displayName   String?  @map("display_name")
  bankName      String?  @map("bank_name")
  accountNumber String?  @map("account_number")
  accountName   String?  @map("account_name")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("educator_profiles")
}

model EducatorApplication {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  applicantType   String   @default("individual") @map("applicant_type")
  fullName        String   @default("") @map("full_name")
  orgName         String   @default("") @map("org_name")
  cacNumber       String   @default("") @map("cac_number")
  bio             String   @default("")
  expertise       Json?
  sampleLinks     Json?    @map("sample_links")
  phone           String   @default("")
  ninLast4        String   @default("") @map("nin_last4")
  bankCode        String   @default("") @map("bank_code")
  bankName        String   @default("") @map("bank_name")
  accountNumber   String   @default("") @map("account_number")
  accountName     String   @default("") @map("account_name")
  accountVerified Boolean  @default(false) @map("account_verified")
  status          String   @default("pending")
  rejectionReason String?  @map("rejection_reason")
  nin             String?
  cvUrl           String?  @map("cv_url")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("educator_applications")
}

model EducatorApplicationSecret {
  id        String   @id @default(uuid())
  userId    String   @map("user_id") @unique
  nin       String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("educator_application_secrets")
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String   @map("actor_id")
  action    String
  entity    String
  entityId  String   @map("entity_id")
  details   Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_log")
}

model Course {
  id                 String       @id @default(uuid())
  slug               String
  persona            String       @default("youth")
  title              String
  category           String?      @default("01") @map("category_id")
  description        String       @db.Text @map("summary")
  overview           String?      @db.Text
  tone               String       @default("bg-sky")
  imageUrl           String?      @map("image_url")
  ecardUrl           String?      @map("ecard_url")
  status             String       @default("draft")
  isPublished        Boolean      @default(true) @map("published")
  featured           Boolean      @default(false)
  sortOrder          Int          @default(0) @map("sort_order")
  country            String       @default("Global")
  tier               String?
  price              Int?         @map("price")
  outcomes           Json?
  sessions           Json?
  
  // Added fields from frontend
  educatorId         String?      @map("educator_id")
  authorName         String?      @map("author_name")
  authorAvatarUrl    String?      @map("author_avatar_url")
  courseLevel        String?      @default("beginner") @map("course_level")
  language           String?      @default("English") @map("language")
  delivery           String?      @default("online") @map("delivery")
  durationHours      Int?         @default(0) @map("duration_hours")
  passMark           Int?         @default(70) @map("pass_mark")
  sequentialModules  Boolean      @default(true) @map("sequential_modules")
  requireAssessment  Boolean      @default(true) @map("require_assessment")
  rejectionReason    String?      @map("rejection_reason")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  enrollmentCount    Int          @default(0) @map("enrollment_count")
  level              String?      @default("beginner")
  publishedAt        DateTime?    @map("published_at")
  rating             Float?

  modules            Module[]
  enrollments        Enrollment[]
  certificates       Certificate[]

  @@unique([persona, slug])
  @@map("courses")
}

model CourseRevision {
  id        String   @id @default(uuid())
  courseId  String   @map("course_id")
  status    String   @default("pending")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("course_revisions")
}

model CourseMaterial {
  id          String   @id @default(uuid())
  courseId    String   @map("course_id")
  title       String
  description String?
  fileUrl     String?  @map("file_url")
  fileType    String?  @map("file_type")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("course_materials")
}

model CourseAnnouncement {
  id         String   @id @default(uuid())
  courseId   String   @map("course_id")
  educatorId String   @map("educator_id")
  title      String
  body       String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("course_announcements")
}

model Training {
  id              String    @id @default(uuid())
  title           String
  summary         String    @db.Text
  country         String
  city            String    @default("")
  venue           String    @default("")
  eventDate       DateTime? @db.Date @map("event_date")
  endDate         DateTime? @db.Date @map("end_date")
  eventTime       String    @default("") @map("event_time")
  format          String    @default("In person")
  registrationUrl String    @default("") @map("registration_url")
  imageUrl        String    @default("") @map("image_url")
  published       Boolean   @default(true)
  sortOrder       Int       @default(0) @map("sort_order")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("trainings")
}

model TrainingForm {
  id             String              @id @default(uuid())
  slug           String              @unique
  title          String
  description    String              @default("") @db.Text
  successMessage String              @default("Thanks. We received your request.") @map("success_message")
  published      Boolean             @default(true)
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  fields         TrainingFormField[]
  submissions    TrainingSubmission[]

  @@map("training_forms")
}

model TrainingFormField {
  id          String       @id @default(uuid())
  formId      String       @map("form_id")
  name        String
  label       String
  helpText    String       @default("") @map("help_text")
  placeholder String       @default("")
  kind        String       @default("short_text")
  options     Json?
  required    Boolean      @default(false)
  sortOrder   Int          @default(0) @map("sort_order")
  form        TrainingForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@map("training_form_fields")
}

model TrainingSubmission {
  id           String       @id @default(uuid())
  formId       String       @map("form_id")
  trainingId   String?      @map("training_id")
  contactEmail String       @default("") @map("contact_email")
  answers      Json
  status       String       @default("new")
  adminNotes   String       @default("") @db.Text @map("admin_notes")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  form         TrainingForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@map("training_submissions")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  title     String
  body      String?   @db.Text
  link      String?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model SiteContent {
  key       String   @id
  label     String   @default("")
  data      Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_content")
}

model AppSetting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

model Module {
  id              String   @id @default(uuid())
  courseId        String   @map("course_id")
  title           String
  order           Int      @map("sort_order")
  contentType     String   @map("content_type")
  contentUrl      String?  @map("content_url")
  videoUrl        String?  @map("video_url")
  fileUrl         String?  @map("file_url")
  contentBody     String?  @db.Text @map("content")
  contentMeta     Json?    @map("content_meta")
  durationMinutes Int?     @map("duration_minutes")
  isPublished     Boolean  @default(true) @map("is_published")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  course          Course   @relation(fields: [courseId], references: [id])
  completions     ModuleCompletion[]
  assignment      Assignment?

  @@map("modules")
}

model Assignment {
  id              String   @id @default(uuid())
  moduleId        String   @unique @map("module_id")
  title           String
  description     String   @db.Text
  attachmentUrl   String?  @map("attachment_url")
  submissionType  String   @default("text") @map("submission_type")
  dueDate         DateTime? @map("due_date")
  maxScore        Int?     @map("max_score")
  passMark        Int?     @map("pass_mark")
  isRequired      Boolean  @default(false) @map("is_required")
  isEnabled       Boolean  @default(true) @map("is_enabled")
  module          Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  submissions     AssignmentSubmission[]

  @@map("assignments")
}

model AssignmentSubmission {
  id           String   @id @default(uuid())
  assignmentId String   @map("assignment_id")
  userId       String   @map("user_id")
  content      String?  @db.Text
  fileUrl      String?  @map("file_url")
  status       String   @default("submitted")
  score        Int?
  feedback     String?  @db.Text
  submittedAt  DateTime @default(now()) @map("submitted_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, userId])
  @@map("assignment_submissions")
}

model Enrollment {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  courseId        String    @map("course_id")
  progressPct     Int       @default(0) @map("progress_pct")
  enrolledAt      DateTime  @default(now()) @map("enrolled_at")
  completedAt     DateTime? @map("completed_at")
  status          String    @default("active")
  paymentId       String?   @map("payment_id")
  paymentStatus   String    @default("unpaid") @map("payment_status")
  paymentProofUrl String?   @map("payment_proof_url")
  rejectionReason String?   @map("rejection_reason")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  user            User      @relation(fields: [userId], references: [id])
  course          Course    @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
  @@map("enrollments")
}

model Payment {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  courseId        String    @map("course_id")
  enrollmentId    String?   @map("enrollment_id")
  reference       String    @unique
  method          String    @default("bank_transfer")
  status          String    @default("pending")
  amountKobo      Int       @default(0) @map("amount_kobo")
  proofPath       String?   @map("proof_path")
  payerName       String?   @map("payer_name")
  note            String?   @db.Text
  rejectionReason String?   @map("rejection_reason")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([userId, status])
  @@index([courseId, status])
  @@map("payments")
}

model ModuleCompletion {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  moduleId    String   @map("module_id")
  completedAt DateTime @default(now()) @map("completed_at")
  module      Module   @relation(fields: [moduleId], references: [id])

  @@unique([userId, moduleId])
  @@map("module_completions")
}

model PayoutRequest {
  id                 String   @id @default(uuid())
  educatorId         String   @map("educator_id")
  amountKobo         Int      @map("amount_kobo")
  status             String
  bankSnapshot       Json     @map("bank_snapshot")
  dueBy              DateTime @map("due_by")
  transferReference  String?  @map("transfer_reference")
  rejectionReason    String?  @map("rejection_reason")
  processedAt        DateTime? @map("processed_at")
  processedBy        String?  @map("processed_by")
  requestedAt        DateTime @default(now()) @map("requested_at")

  @@map("payout_requests")
}

model LedgerEntry {
  id              String   @id @default(uuid())
  paymentId       String?  @map("payment_id")
  courseId        String?  @map("course_id")
  educatorId      String   @map("educator_id")
  party           String
  status          String
  amountKobo      Int      @map("amount_kobo")
  grossKobo       Int      @map("gross_kobo")
  gatewayFeeKobo  Int      @map("gateway_fee_kobo")
  netKobo         Int      @map("net_kobo")
  splitPct        Int      @map("split_pct")
  availableAt     DateTime @map("available_at")
  note            String?
  payoutRequestId String?  @map("payout_request_id")

  @@map("ledger_entries")
}

model Certificate {
  id           String   @id @default(uuid())
  code         String   @unique
  userId       String   @map("user_id")
  courseId     String   @map("course_id")
  courseTitle  String   @map("course_title")
  learnerName  String   @map("learner_name")
  issuedAt     DateTime @default(now()) @map("issued_at")

  user         User     @relation(fields: [userId], references: [id])
  course       Course   @relation(fields: [courseId], references: [id])

  @@map("certificates")
}
